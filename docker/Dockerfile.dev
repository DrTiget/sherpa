# Среда сборки Linux: Rust + системные зависимости Tauri 2 (webkit2gtk 4.1).
FROM rust:1-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libssl-dev \
    libxdo-dev libdbus-1-dev pkg-config build-essential curl ca-certificates openssh-client \
    && rm -rf /var/lib/apt/lists/*
