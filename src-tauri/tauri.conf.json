{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ServerGUI",
  "version": "0.1.0",
  "identifier": "dev.servergui.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ServerGUI", "width": 1100, "height": 720, "minWidth": 800, "minHeight": 520 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
