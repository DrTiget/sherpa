# ServerGUI: улучшенная оболочка (bash fallback) в стиле Kali. ~/.bashrc не затрагивается.
[[ $LANG == *UTF-8* || $LC_ALL == *UTF-8* ]] || export LC_CTYPE=C.UTF-8

HISTFILE="$HOME/.servergui/history_bash"
HISTSIZE=10000; HISTFILESIZE=10000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend checkwinsize globstar 2>/dev/null

# bash-completion, если установлен
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then . /etc/bash_completion; fi
fi

# стрелки ищут по префиксу введённого, меню дополнения с цветами
bind '"\e[A": history-search-backward' 2>/dev/null
bind '"\e[B": history-search-forward' 2>/dev/null
bind '"\e[1;5C": forward-word' 2>/dev/null
bind '"\e[1;5D": backward-word' 2>/dev/null
bind '"\e[Z": menu-complete-backward' 2>/dev/null
bind 'set show-all-if-ambiguous on' 2>/dev/null
bind 'set menu-complete-display-prefix on' 2>/dev/null
bind 'set colored-stats on' 2>/dev/null
bind 'set colored-completion-prefix on' 2>/dev/null
bind 'set completion-ignore-case on' 2>/dev/null
bind '"\t": menu-complete' 2>/dev/null

if [ -x /usr/bin/dircolors ]; then eval "$(dircolors -b)"; fi
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias egrep='grep -E --color=auto'
alias fgrep='grep -F --color=auto'
alias diff='diff --color=auto'
alias ll='ls -l'
alias la='ls -A'
alias l='ls -CF'
export LESS_TERMCAP_md=$'\E[1;34m' LESS_TERMCAP_us=$'\E[4;36m' LESS_TERMCAP_ue=$'\E[0m' LESS_TERMCAP_me=$'\E[0m'

# промпт Kali
if [ "$EUID" -eq 0 ]; then _c=31; _u='💀'; else _c=34; _u='㉿'; fi
PS1='\[\e['$_c'm\]┌──(\[\e[1;'$_c'm\]\u'$_u'\h\[\e[0;'$_c'm\])-[\[\e[0m\e[1m\]\w\[\e[0;'$_c'm\]]\n\[\e[0;'$_c'm\]└─\[\e[1;'$_c'm\]\$\[\e[0m\] '
unset _c _u
PROMPT_COMMAND='printf "\033]0;%s@%s: %s\007" "$USER" "${HOSTNAME%%.*}" "${PWD/#$HOME/~}"'
